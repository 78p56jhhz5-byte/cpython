    transform: translateY(-1px);
    box-shadow: 0 0 20px rgba(255, 0, 127, 0.5);
}

.form-output {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--neon-pink);
    padding: 5px;
}

/* Responsive Styles */
@media (max-width: 992px) {
    .workspace {
        flex-direction: column;
    }
    
    .details-drawer {
        width: 100vw;
        height: 420px;
        position: fixed;
        bottom: 0;
        left: 0;
        transform: translateY(100%);
        border-left: none;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .details-drawer.open {
        transform: translateY(0);
        transform: translateX(0);
    }
    
    .app-header {
        flex-direction: column;
        height: auto;
        padding: 15px;
        gap: 12px;
    }
    
    .workspace {
        padding-top: 150px;
    }
    
    .controls-panel {
        width: 100%;
        justify-content: center;
    }
}
