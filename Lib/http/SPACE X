// Initialize particles for ambient flow animation
let particles = [];
const particleCount = 100;

function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}
window.addEventListener("resize", resizeCanvas);
resizeCanvas();

class AmbientParticle {
    constructor() {
        this.reset();
        this.y = Math.random() * canvas.height;
    }

    reset() {
        this.x = Math.random() * canvas.width;
        this.y = -10;
        this.vy = Math.random() * 1.5 + 0.5;
        this.size = Math.random() * 2 + 0.5;
        this.alpha = Math.random() * 0.3 + 0.05;
        this.color = Math.random() > 0.5 ? "0, 240, 255" : "189, 0, 255";
    }

    update() {
        this.y += this.vy;
        if (this.y > canvas.height) {
            this.reset();
        }
    }

    draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${this.color}, ${this.alpha})`;
        ctx.fill();
    }
}

for (let i = 0; i < particleCount; i++) {
    particles.push(new AmbientParticle());
}

function animateParticles() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach(p => {
        p.update();
        p.draw();
    });
    requestAnimationFrame(animateParticles);
}
animateParticles();

// Center the viewport on the center profile node
function centerViewport() {
    const vRect = viewport.getBoundingClientRect();
    transX = vRect.width / 2 - center.x;
    transY = vRect.height / 2 - center.y;
    updateBoardTransform();
}

function updateBoardTransform() {
    board.style.transform = `translate(${transX}px, ${transY}px) scale(${zoom})`;
}

// Click and Drag backdrop to pan
viewport.addEventListener("mousedown", (e) => {
    if (e.target.closest(".satellite-node") || e.target.closest(".avatar-box")) return;
    dragActive = true;
    viewport.classList.add("dragging");
    startMouseX = e.clientX - transX;
    startMouseY = e.clientY - transY;
});

window.addEventListener("mousemove", (e) => {
    if (!dragActive) return;
    transX = e.clientX - startMouseX;
    transY = e.clientY - startMouseY;
    updateBoardTransform();
});

window.addEventListener("mouseup", () => {
    dragActive = false;
    viewport.classList.remove("dragging");
});

// Scroll wheel to rotate orbits
viewport.addEventListener("wheel", (e) => {
    e.preventDefault();
    if (gridModeActive) return; // Disable rotation when grid is snapped

    const speed = e.deltaY * 0.001;
    globalRotationOffset += speed;
    repositionNodes();
    drawConnections();
});

// Reposition Satellite Nodes on Concentric Rings
function repositionNodes() {
    const nodes = document.querySelectorAll(".satellite-node");
    nodes.forEach(node => {
        const id = node.getAttribute("data-id");
        const item = nodesData.find(x => x.id === id);
        if (!item) return;

        const radius = ringRadii[item.ring];
        const angle = item.angle + globalRotationOffset;

        const x = center.x + radius * Math.cos(angle) - 33;
        const y = center.y + radius * Math.sin(angle) - 33;

        node.style.left = `${x}px`;
        node.style.top = `${y}px`;
    });
}

// Generate satellite elements inside HTML
function injectNodes() {
    // Clear nodes
    const existing = board.querySelectorAll(".satellite-node");
    existing.forEach(e => e.remove());

    nodesData.forEach(item => {
        const node = document.createElement("div");
        node.className = "satellite-node";
        node.setAttribute("data-id", item.id);
        node.style.setProperty("--n-color", item.color);
        node.style.setProperty("--n-glow", item.glow);

        node.innerHTML = `
            <i class="fa-solid ${item.icon}"></i>
            <div class="node-title-label">${item.title}</div>
        `;

        node.addEventListener("click", () => selectNode(item.id));
        board.appendChild(node);
    });

    repositionNodes();
    drawConnections();
}

// Draw connection lines connecting core to satellites
function drawConnections() {
    connectionsSvg.innerHTML = "";
    
    const vRect = viewport.getBoundingClientRect();
    connectionsSvg.setAttribute("width", vRect.width);
    connectionsSvg.setAttribute("height", vRect.height);

    nodesData.forEach(item => {
        const node = board.querySelector(`.satellite-node[data-id="${item.id}"]`);
        if (!node || node.classList.contains("filtered")) return;

        const nodeRect = node.getBoundingClientRect();
        const coreNode = board.querySelector(".avatar-box");
        const coreRect = coreNode.getBoundingClientRect();

        const x1 = coreRect.left + coreRect.width / 2 - vRect.left;
        const y1 = coreRect.top + coreRect.height / 2 - vRect.top;
        const x2 = nodeRect.left + nodeRect.width / 2 - vRect.left;
        const y2 = nodeRect.top + nodeRect.height / 2 - vRect.top;

        const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
        line.setAttribute("x1", x1);
        line.setAttribute("y1", y1);
        line.setAttribute("x2", x2);
        line.setAttribute("y2", y2);

        if (item.id === activeNodeId) {
            line.setAttribute("stroke", item.color);
            line.setAttribute("stroke-width", "2");
            line.style.filter = `drop-shadow(0 0 4px ${item.color})`;
            line.setAttribute("stroke-dasharray", "8, 4");
            line.setAttribute("stroke-dashoffset", "0");
            line.style.animation = "pulseDash 1.5s infinite linear";

            // Register pulse animation once
            if (!document.getElementById("svg-pulse-dash-anim")) {
                const style = document.createElement("style");
                style.id = "svg-pulse-dash-anim";
                style.textContent = `@keyframes pulseDash { to { stroke-dashoffset: -24; } }`;
                document.head.appendChild(style);
            }
        } else {
            line.setAttribute("stroke", "rgba(255,255,255,0.04)");
            line.setAttribute("stroke-width", "1");
        }

        connectionsSvg.appendChild(line);
    });
}

// Select node, center view, and inject layout data in sliding panel
function selectNode(id) {
    const item = nodesData.find(x => x.id === id);
    if (!item) return;

    activeNodeId = id;

    // Set highlights on selected node element
    document.querySelectorAll(".satellite-node").forEach(node => {
        if (node.getAttribute("data-id") === id) {
            node.classList.add("active");
        } else {
            node.classList.remove("active");
        }
    });

    // Update drawer header accent colors
    drawer.style.setProperty("--dw-color", item.color);
    drawerTag.textContent = item.category.toUpperCase();

    // Populate drawer body
    injectDrawerContent(item);

    drawer.classList.add("open");
    drawConnections();
}

