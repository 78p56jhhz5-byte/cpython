// Close drawer panel
closeDrawerBtn.addEventListener("click", () => {
    drawer.classList.remove("open");
    activeNodeId = null;
    document.querySelectorAll(".satellite-node").forEach(node => node.classList.remove("active"));
    drawConnections();
});

// Category filtering
filterBtns.forEach(btn => {
    btn.addEventListener("click", () => {
        filterBtns.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");

        const cat = btn.getAttribute("data-category");
        filterNodes(cat);
    });
});

function filterNodes(category) {
    const nodes = document.querySelectorAll(".satellite-node");
    nodes.forEach(node => {
        const id = node.getAttribute("data-id");
        const item = nodesData.find(x => x.id === id);
        if (!item) return;

        if (category === "all" || item.category === category) {
            node.classList.remove("filtered");
        } else {
            node.classList.add("filtered");
            if (item.id === activeNodeId) {
                drawer.classList.remove("open");
                activeNodeId = null;
            }
        }
    });

    drawConnections();
}

// Gravity Grid Snap Toggle (Locks orbits in linear grids)
gridSnapBtn.addEventListener("click", () => {
    gridModeActive = !gridModeActive;
    gridSnapBtn.classList.toggle("active", gridModeActive);

    const nodes = document.querySelectorAll(".satellite-node");
    const guides = document.querySelectorAll(".orbit-guide");

    if (gridModeActive) {
        // Linear grid alignment snap (Layout collapse simulation)
        guides.forEach(g => g.style.opacity = "0.02");
        
        let idx = 0;
        nodes.forEach(node => {
            if (node.classList.contains("filtered")) return;
            const x = center.x + 200 + (Math.floor(idx / 2) * 180) - 33;
            const y = center.y - 150 + ((idx % 2) * 300) - 33;
            node.style.left = `${x}px`;
            node.style.top = `${y}px`;
            idx++;
        });
    } else {
        // Reset to original concentric orbits
        guides.forEach(g => g.style.opacity = "1");
        repositionNodes();
    }
    
    // Delay draw to allow CSS transitions to finish coordinates lookup
    setTimeout(drawConnections, 300);
});

// Theme / Overdrive Toggle
overdriveBtn.addEventListener("click", () => {
    document.body.classList.toggle("overdrive-on");
    
    if (document.body.classList.contains("overdrive-on")) {
        overdriveBtn.innerHTML = `<i class="fa-solid fa-burst"></i> <span>OVERDRIVE ON</span>`;
        overdriveBtn.style.color = "#000";
        overdriveBtn.style.background = "var(--neon-pink)";
        overdriveBtn.style.boxShadow = "var(--glow-pink)";
        
        // Speed up particles
        particles.forEach(p => p.vy *= 3);
    } else {
        overdriveBtn.innerHTML = `<i class="fa-solid fa-radiation"></i> <span>OVERDRIVE</span>`;
        overdriveBtn.style.color = "var(--neon-purple)";
        overdriveBtn.style.background = "rgba(255,255,255,0.02)";
        overdriveBtn.style.boxShadow = "none";
        
        // Reset particles speed
        particles.forEach(p => p.vy /= 3);
    }
});

