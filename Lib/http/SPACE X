    const form = document.getElementById("contact-sync-form");

    output.style.color = "var(--neon-pink)";
    output.textContent = "SYNCHRONIZING SECURE TUNNEL...";
    
    // Disable inputs
    form.querySelectorAll(".form-input, .form-submit-btn").forEach(i => i.disabled = true);

    setTimeout(() => {
