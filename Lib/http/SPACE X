const ctx = canvas.getContext("2d");

// Interactive Viewport Constants
const center = { x: 1200, y: 1200 };
const ringRadii = { 1: 190, 2: 340, 3: 490 };

let zoom = 1;
let transX = 0;
let transY = 0;
let dragActive = false;
let startMouseX = 0;
let startMouseY = 0;
let globalRotationOffset = 0;
