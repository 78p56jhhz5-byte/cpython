// BCI Terminal Console logic
function bindConsoleLogic() {
    const input = document.getElementById("cons-inp");
    const history = document.getElementById("cons-hist");
    
    if (!input || !history) return;

    input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
            const command = input.value.trim().toLowerCase();
            input.value = "";

            // Write command to history
            history.innerHTML += `\n&gt; ${command}`;

            let reply = "";
            if (command === "help") {
                reply = "Available command indices:\n- 'about' : Returns profile credentials.\n- 'skills' : Prints validated capabilities.\n- 'projects' : Lists creations catalog.\n- 'clear' : Erases terminal buffers.";
            } else if (command === "about") {
                reply = "Identity: Dell\nSpecialization: Interface Architect\nPhilosophy: Dynamic structural decoupling.";
            } else if (command === "skills") {
                reply = "Capacities:\n- WebAudio Algorithms: 94%\n- CSS Grid Morphing: 96%\n- Spatial Canvas APIs: 88%";
            } else if (command === "projects") {
                reply = "Creations Node Index:\n- 'REM Dream Engine' (Interactive VR sleep visualizer)\n- 'AtmosWeave' (Atmosphere fluid smart clothing)\n- 'ChronosVault' (Geolocated point-cloud memory grid)\n- 'Synapse-Collab' (Brainwave parity developer workstation)";
            } else if (command === "clear") {
                history.innerHTML = "DELL_PORTAL Console OS [Version 4.2.1]\nType 'help' to query directory nodes.";
                return;
            } else if (command === "overdrive") {
                reply = "OVERDRIVE PROTOCOL INJECTED. Velocity modifiers increased.";
                document.getElementById("overdrive-toggle").click();
            } else if (command === "") {
                return;
            } else {
                reply = `Command error: index '${command}' unrecognized. Enter 'help' for support.`;
            }

            history.innerHTML += `\n${reply}`;
            history.scrollTop = history.scrollHeight;
        }
    });

    // Auto-focus console
    input.focus();
}

